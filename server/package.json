{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "postinstall": "bun --bun prisma generate",
    "db:generate": "bun --bun prisma generate",
    "db:migrate": "bun --bun prisma migrate dev",
    "db:deploy": "bun --bun prisma migrate deploy",
    "db:seed": "bun --bun prisma db seed",
    "db:studio": "bun --bun prisma studio",
    "email:sample": "bun scripts/send-sample-email.ts",
    "tickets:sample": "bun scripts/create-sample-tickets.ts",
    "conversation:sample": "bun scripts/create-sample-conversation.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.93",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "ai": "^7.0.137",
    "better-auth": "^1.7.7",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/express": "^5.0.6",
    "prisma": "7.10.0",
    "typescript": "^7.0.2"
  }
}
