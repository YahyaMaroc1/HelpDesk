PORT=3000
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/helpdesk?schema=public
# Better Auth – generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Client dev server origin, trusted by Better Auth's origin check
CLIENT_ORIGIN=http://localhost:5173
# Only behind a reverse proxy: its address/CIDR (or hop count), so rate limits see the real client IP
TRUST_PROXY=
# Admin user created by `bun run db:seed`
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@yay.com
ADMIN_PASSWORD=
# Shared secret the mail pipeline sends in the X-Webhook-Secret header to POST /api/webhooks/inbound-email.
# Generate with: openssl rand -base64 32. Inbound email is rejected (503) while it's empty.
INBOUND_EMAIL_SECRET=
